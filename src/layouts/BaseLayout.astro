---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import type { Lang, RouteKey } from '../i18n/ui';
import { pathFor, t, withBase } from '../i18n/ui';
import { identity } from '../config';

export interface Props {
  title: string;
  description: string;
  route: RouteKey;
  lang?: Lang;
  /** Optional path to an OG image relative to the site root. */
  ogImage?: string;
  /** Keep a page out of the index and drop its canonical. Used by the 404. */
  noindex?: boolean;
}

const { title, description, route, lang = 'en', ogImage = '/og-default.png', noindex = false } = Astro.props;

const strings = t(lang);
const site = Astro.site ?? new URL('https://www.consultores-tic.com');
const canonical = new URL(pathFor(route, lang), site);
const alternateEn = new URL(pathFor(route, 'en'), site);
const alternateEs = new URL(pathFor(route, 'es'), site);
const ogImageUrl = new URL(withBase(ogImage), site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}

    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="x-default" href={alternateEn} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={strings.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${identity.displayName} — Senior Software Engineer, backend systems and APIs`}
    />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_PE'} />
    <meta
      property="og:locale:alternate"
      content={lang === 'en' ? 'es_PE' : 'en_US'}
    />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: identity.displayName,
        url: identity.siteUrl,
        email: `mailto:${identity.publicEmail}`,
        jobTitle: 'Senior Software Engineer',
        description,
        sameAs: [identity.githubUrl],
        knowsAbout: [
          'Backend engineering',
          'REST APIs',
          'Node.js',
          'TypeScript',
          'PHP',
          'AWS',
          'Redis',
          'Queue-based processing',
        ],
      })}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{strings.skipToContent}</a>

    <Header lang={lang} route={route} />

    <div class="container lang-switch-bar">
      <LanguageSwitcher lang={lang} route={route} />
    </div>

    <main id="main" class="container">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>

<style>
  .lang-switch-bar {
    display: flex;
    justify-content: flex-end;
    padding-top: var(--space-2);
  }
</style>
