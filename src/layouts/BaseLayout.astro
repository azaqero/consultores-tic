---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import type { Lang, RouteKey } from '../i18n/ui';
import { pathFor, t, withBase } from '../i18n/ui';
import { identity } from '../config';

export interface Props {
  title: string;
  description: string;
  route: RouteKey;
  lang?: Lang;
  /** Optional path to an OG image relative to the site root. */
  ogImage?: string;
  /** Keep a page out of the index and drop its canonical. Used by the 404. */
  noindex?: boolean;
}

const { title, description, route, lang = 'en', ogImage, noindex = false } = Astro.props;

const strings = t(lang);
const site = Astro.site ?? new URL('https://www.consultores-tic.com');
const canonical = new URL(pathFor(route, lang), site);
const alternateEn = new URL(pathFor(route, 'en'), site);
const alternateEs = new URL(pathFor(route, 'es'), site);

/**
 * Per-language social metadata.
 *
 * The copy lives here instead of in `i18n/ui.ts` because it only feeds head
 * tags and structured data, never the visible UI. `image` points at the card
 * generated by `scripts/generate-og.mjs`.
 */
const social = {
  en: {
    image: '/og-default.png',
    imageAlt: `${identity.displayName} — Senior Software Engineer, backend systems and APIs`,
    jobTitle: 'Senior Software Engineer',
    knowsAbout: [
      'Backend engineering',
      'REST APIs',
      'Node.js',
      'TypeScript',
      'PHP',
      'AWS',
      'Redis',
      'Queue-based processing',
    ],
  },
  es: {
    image: '/og-es.png',
    imageAlt: `${identity.displayName} — Ingeniero de Software Senior, sistemas backend y APIs`,
    jobTitle: 'Ingeniero de Software Senior',
    knowsAbout: [
      'Ingeniería backend',
      'APIs REST',
      'Node.js',
      'TypeScript',
      'PHP',
      'AWS',
      'Redis',
      'Procesamiento por colas',
    ],
  },
}[lang];

const ogImageUrl = new URL(withBase(ogImage ?? social.image), site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}

    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="x-default" href={alternateEn} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={strings.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={social.imageAlt} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_PE'} />
    <meta
      property="og:locale:alternate"
      content={lang === 'en' ? 'es_PE' : 'en_US'}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={social.imageAlt} />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: identity.displayName,
        url: identity.siteUrl,
        email: `mailto:${identity.publicEmail}`,
        jobTitle: social.jobTitle,
        description,
        inLanguage: lang === 'en' ? 'en' : 'es',
        sameAs: [identity.githubUrl],
        knowsAbout: social.knowsAbout,
      })}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{strings.skipToContent}</a>

    <Header lang={lang} route={route} />

    <div class="container lang-switch-bar">
      <LanguageSwitcher lang={lang} route={route} />
    </div>

    <main id="main" class="container">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>

<style>
  .lang-switch-bar {
    display: flex;
    justify-content: flex-end;
    padding-top: var(--space-2);
  }
</style>
