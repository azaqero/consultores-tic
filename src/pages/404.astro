---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pathFor } from '../i18n/ui';
---

<BaseLayout
  title="404 — Page not found | Consultores TIC"
  description="This page does not exist. / Esta página no existe."
  route="home"
  lang="en"
  noindex
>
  <section class="notfound">
    <p class="eyebrow">404</p>
    <h1>This page doesn’t exist.</h1>
    <p>
      It may have been part of the old site. The current one has a different
      structure.
    </p>
    <p>
      <a href={pathFor('home', 'en')}>Home</a> ·
      <a href={pathFor('projects', 'en')}>Projects</a> ·
      <a href={pathFor('profile', 'en')}>Profile</a> ·
      <a href={pathFor('contact', 'en')}>Contact</a>
    </p>

    <hr />

    <p lang="es"><strong>Esta página no existe.</strong></p>
    <p lang="es">
      Puede haber sido parte del sitio anterior. El actual tiene otra estructura.
    </p>
    <p lang="es">
      <a href={pathFor('home', 'es')}>Inicio</a> ·
      <a href={pathFor('projects', 'es')}>Proyectos</a> ·
      <a href={pathFor('profile', 'es')}>Perfil</a> ·
      <a href={pathFor('contact', 'es')}>Contacto</a>
    </p>
  </section>
</BaseLayout>

<style>
  .notfound {
    max-width: 40rem;
    padding-block: var(--space-5);
  }

  .notfound hr {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: var(--space-4) 0;
  }

  .notfound p {
    color: var(--color-muted);
  }
</style>
