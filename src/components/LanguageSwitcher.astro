---
import type { Lang, RouteKey } from '../i18n/ui';
import { counterpart, languages, otherLang, t } from '../i18n/ui';

export interface Props {
  lang: Lang;
  route: RouteKey;
}

const { lang, route } = Astro.props;
const strings = t(lang);
const target = otherLang(lang);
---

<a
  class="lang-switch"
  href={counterpart(route, lang)}
  hreflang={target}
  lang={target}
  aria-label={`${strings.languageLabel}: ${languages[target]}`}
>
  <span aria-hidden="true" class="lang-switch__code">{target.toUpperCase()}</span>
  <span class="lang-switch__label">{strings.switchTo}</span>
</a>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .lang-switch:hover {
    color: var(--color-text);
    border-color: var(--color-muted);
  }

  .lang-switch__code {
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  @media (width < 30rem) {
    .lang-switch__label {
      display: none;
    }
  }
</style>
